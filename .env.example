# Copy this file to .env and fill in whichever of these you want to enable
# (cp .env.example .env). Both are optional - unset means the corresponding
# feature quietly no-ops instead of failing. See README.md for details.
#
# Read automatically by:
# - `uv run main.py` / `make up` (via python-dotenv, see main.py)
# - `docker compose up` (Compose loads a root .env on its own)

# Enables real, third-party-monitored credentials planted in canary .env
# files and GitHub issue comments (backend/thinkst.py). Must be an email
# you actually control - Thinkst requires one per token even though this
# only ever polls, never relies on that channel firing.
THINKST_ALERT_EMAIL=

# Enables the "GitHub repository" canary type (backend/github_canary.py).
# Create a public repo by hand first, then a fine-grained PAT scoped to
# JUST that repo (Contents, Issues, Pull requests: read & write) - not a
# classic PAT, and not your personal account's, since this repo gets real
# public "leaked solutions" content (and fake credentials in an issue
# comment) written to it under whatever account the token belongs to.
GITHUB_TOKEN=
GITHUB_REPO_FULL_NAME=
