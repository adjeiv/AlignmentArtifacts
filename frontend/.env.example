# Copy to .env.local for local dev overrides (both optional).

# "false" to hit a real backend instead of the built-in mock data.
VITE_USE_MOCK=true

# Only used when VITE_USE_MOCK=false. Left as "/api" to go through Vite's
# dev-server proxy (see vite.config.ts, respects BACKEND_URL); point it at a
# full origin (e.g. http://localhost:8000/api) to bypass the proxy entirely.
VITE_API_BASE_URL=/api
