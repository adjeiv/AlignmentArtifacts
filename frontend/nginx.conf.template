server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Docker's embedded DNS (only reachable on a user-defined/compose
    # network). Combined with the $backend variable below, this makes nginx
    # resolve BACKEND_ORIGIN lazily per-request instead of at startup - so
    # the container still starts and serves the SPA even when run standalone
    # (no "backend" host to resolve, e.g. in mock mode) instead of crash-
    # looping with "host not found in upstream".
    resolver 127.0.0.11 valid=10s ipv6=off;

    # Proxied to the backend service (see CONTRACT.md for the endpoint list).
    # ${BACKEND_ORIGIN} is substituted from the environment by nginx's
    # docker-entrypoint on container start (envsubst over *.template files).
    # No path on proxy_pass (deliberately - it's a variable, so nginx would
    # forward the literal path here instead of the actual request path):
    # backend routes already start with /api/, so we want a byte-for-byte
    # passthrough of the incoming URI, which omitting it gives us.
    location /api/ {
        set $backend "${BACKEND_ORIGIN}";
        proxy_pass $backend;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SPA fallback so client-side routes (e.g. /companies/1) resolve on
    # direct load / refresh instead of 404ing.
    location / {
        try_files $uri /index.html;
    }
}
